{
  "name": "dsh-conv-calendar",
  "version": "0.1.1",
  "description": "DeepSeek Harness 的 GitHub 风格对话日历：按天显示提示词、会话和 token 使用量，并在 Web GUI 中绘制为贡献网格。GitHub-style conversation calendar for DeepSeek Harness: prompts, sessions and token usage per day, drawn as a contribution grid in the Web GUI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "calendar",
    "heatmap",
    "contribution-graph",
    "contribution-calendar",
    "tokens",
    "usage",
    "stats"
  ],
  "homepage": "https://github.com/Leni-More/dsh-conv-calendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leni-More/dsh-conv-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/Leni-More/dsh-conv-calendar/issues"
  },
  "author": "LeniMore <LeniMore0@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "./lib/client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
